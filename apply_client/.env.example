# apply_client/.env — copy this file to apply_client/.env and fill it in.

# The Jetson dashboard, e.g. http://192.168.5.58:8080 or your Tailscale name
JETSON_URL=http://192.168.5.58:8080

# Must match APPLY_CLIENT_TOKEN in the Jetson's config/secrets.env
APPLY_CLIENT_TOKEN=

# Persistent Chrome profile — log in to Workday/Greenhouse/Indeed/LinkedIn here once, by hand.
# Default: %LOCALAPPDATA%\job-agent\chrome-profile
# CHROME_PROFILE_DIR=

# Where resume/cover letter PDFs are downloaded per request (deleted afterwards).
# Default: %LOCALAPPDATA%\job-agent\downloads
# DOWNLOAD_DIR=

# Seconds between queue polls in --watch mode
POLL_INTERVAL_SECONDS=20

# Give up (report "abandoned") if you haven't clicked Done/Abandon after this long
HUMAN_TIMEOUT_MINUTES=25
