# config/secrets.env — API keys and tokens
# Copy this file to config/secrets.env and fill in the values.
# DO NOT commit secrets.env to version control.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M

# Shared secret between the Jetson and the Windows apply client (phase 4b).
# Set the same value as APPLY_CLIENT_TOKEN in apply_client/.env.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# While empty, the /api/apply-queue/* routes return 503.
APPLY_CLIENT_TOKEN=
